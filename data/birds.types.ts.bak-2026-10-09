/**
 * Helper functions
 */
export function getRarityLevelText(level: number): string {
  const labels = {
    1: 'Muy Común',
    2: 'Poco Común',
    3: 'Moderado',
    4: 'Común',
    5: 'Bastante Común',
  }
  return labels[level as keyof typeof labels] || 'Desconocido'
}

export function getSizeCategoryText(size: string): string {
  const labels: Record<string, string> = {
    diminuto: 'Diminuto',
    pequeño: 'Pequeño',
    mediano_pequeño: 'Mediano-Pequeño',
    mediano: 'Mediano',
    mediano_grande: 'Mediano-Grande',
    grande: 'Grande',
    muy_grande: 'Muy Grande',
  }
  return labels[size] || size
}

export function getTimeCategoryText(timeOfDay: string): string {
  const labels: Record<string, string> = {
    madrugada: 'Madrugada',
    amanecer: 'Amanecer',
    manana: 'Mañana',
    manana_tarde: 'Mañana-Tarde',
    tarde: 'Tarde',
    amanecer_tarde: 'Amanecer-Tarde',
    todo_dia: 'Todo el Día',
  }
  return labels[timeOfDay] || timeOfDay
}

export function getRarityEmoji(level: number): string {
  return '⭐'.repeat(level)
}
