/**
 * TypeScript types for aves-data.json
 * Usage: import { Bird, BirdsData } from '@/data/aves.types'
 */

export interface Bird {
  id: number
  commonName: string
  scientificName: string
  emoji: string

  // Size
  size: string
  sizeCategory: 'diminuto' | 'pequeño' | 'mediano_pequeño' | 'mediano' | 'mediano_grande' | 'grande' | 'muy_grande'

  // Colors
  colors: string[]
  dominantColor: string

  // Habitat and schedule
  mainHabitat: string
  bestTime: string
  timeCategory: 'madrugada' | 'amanecer' | 'manana' | 'manana_tarde' | 'tarde' | 'amanecer_tarde' | 'todo_dia'

  // Characteristics
  sound: string
  rarity: string
  rarityLevel: 1 | 2 | 3 | 4 | 5
  behavior: string
  conservationStatus: string
  mainType: string

  // Abilities
  traits: string[]

  // Filters
  filters: BirdFilters

  // Identification
  quickId: string
  doNotConfuseWith: string

  // References
  photoUrl: string
  eBirdNotes: string
}

export interface BirdFilters {
  keywords: string[]
  color: string[]
  habitat: string[]
  timeOfDay: string[]
  size: string[]
  activity: string[]
  status: string[]
}

export interface AvailableFilters {
  size: string[]
  color: string[]
  habitat: string[]
  timeOfDay: string[]
  rarity: string[]
  activity: string[]
  conservationStatus: string[]
}

export interface Statistics {
  bySize: Record<string, number>
  byHabitat: Record<string, number>
  byTimeOfDay: Record<string, number>
  byRarity: Record<string, number>
}

export interface Search {
  instructions: string
  examples: string[]
}

export interface BirdsData {
  version: string
  lastUpdated: string
  totalSpecies: number
  birds: Bird[]
  availableFilters: AvailableFilters
  statistics: Statistics
  search: Search
}

/**
 * User observation types
 */
export interface BirdObservation {
  id: string
  birdId: number
  commonName: string
  scientificName: string
  description?: string
  time: string
  date: string
  synced: boolean
  location?: string
  photo?: string
  notes?: string
}

/**
 * Search types
 */
export interface SearchFilters {
  color?: string
  size?: string
  habitat?: string
  timeOfDay?: string
  rarity?: number
  activity?: string
  term?: string
}

export interface SearchResult {
  bird: Bird
  relevance: number
  matchReason: string
}

/**
 * User statistics types
 */
export interface UserStatistics {
  totalObservations: number
  uniqueBirds: number
  commonSpecies: number
  rareSpecies: number
  preferredTime: string
  preferredHabitat: string
  lastObservation: Date
}

/**
 * Challenge types
 */
export interface Challenge {
  id: string
  name: string
  description: string
  criteria: SearchFilters
  goal: number
  reward: string
  difficulty: 'easy' | 'medium' | 'hard'
}

/**
 * Sighting prediction types
 */
export interface ProbableSighting {
  bird: Bird
  probability: number // 0-100
  reason: string
  optimalTime: string
  optimalLocation: string
}

